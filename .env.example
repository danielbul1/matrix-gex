# London Strategic Edge API key
# Get yours at https://londonstrategicedge.com/data
# Used by: fetch_lse.py, server.py (local), and the Railway backend service.
# For the Railway deployment, set LSE_API_KEY in the Railway project's
# environment variables (service code is not yet in this repo — see README).
LSE_API_KEY=lse_live_...

# Optional: override "now" (ET) for freshness checks in tools/ — ISO format,
# e.g. MATRIX_NOW_ET=2026-07-17T10:30:00
#MATRIX_NOW_ET=

# Optional: set to 1 to make tools/smoke_check.py fail on stale data
# (used by the GitHub Actions data-update workflow).
#MATRIX_REQUIRE_FRESH_DATA=
